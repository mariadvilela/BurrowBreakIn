--- !u!114 &230319562
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 230319561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69c754d7a1c0c4e948e176c3571d6298, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneManager
  dialogueLines:
  - speakerName: Mrs. Fox
    dialogueText: You went to the farm, even though I told you not to.
    audioClip: {fileID: 8300000, guid: 7dae8c2e3e30d4cab9c851298a9b849a, type: 3}
  - speakerName: Mr. Fox
    dialogueText: I could not find food in the wild. I had no other option. The children
      are hungry.
    audioClip: {fileID: 8300000, guid: 2f13c87cbc34d4af8a02b7c670450cd3, type: 3}
  - speakerName: Fox Children
    dialogueText: We are hungry!
    audioClip: {fileID: 8300000, guid: 7443fdaff1f094a64881a8222d77b86d, type: 3}
  - speakerName: Mrs. Fox
    dialogueText: "But it\u2019s dangerous."
    audioClip: {fileID: 8300000, guid: 4b1d864f2d68a44198cb1f2ade2db715, type: 3}
  - speakerName: Fox Children
    dialogueText: But mama! We are hungry! We must eat!
    audioClip: {fileID: 8300000, guid: 6d4770429fd9940c2a17d42faf43e74d, type: 3}
  - speakerName: Mrs. Fox
    dialogueText: Alright, fine. As long as you are careful. But do not go to the
      duck farm again. They will be expecting you.
    audioClip: {fileID: 8300000, guid: 3092f4aff989847adaca932efd37b690, type: 3}
  - speakerName: Mr. Fox
    dialogueText: I will be careful my dear, do not worry. Off I go to the chicken
      farm, then.
    audioClip: {fileID: 8300000, guid: d2ec5799b30f8457dacc7a7cd665cf61, type: 3}
  - speakerName: Mrr. Fox
    dialogueText: Remember, the chicken farmer is more alert than the duck farmer.
      You will hae to be quicker.
    audioClip: {fileID: 8300000, guid: bd340053c218741aea3fba9e12508636, type: 3}
  speakerNameText: {fileID: 1736781384}
  dialogueText: {fileID: 730009481}
  continuePromptText: {fileID: 568748083}
  audioSource: {fileID: 0}
  nextSceneName: Puzzle2
  waitForAudioToFinish: 1
